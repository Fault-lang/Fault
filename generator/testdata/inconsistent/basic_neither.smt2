(set-logic QF_NRA)
(declare-fun basic_neither_x_0 () Bool)
(declare-fun basic_neither_isAdmin_0 () Bool)
(declare-fun basic_neither_isBanned_0 () Bool)
(declare-fun basic_neither_x_supported_0 () Bool)
(assert (= basic_neither_x_supported_0 basic_neither_isAdmin_0))
(declare-fun basic_neither_x_defeated_0 () Bool)
(assert (= basic_neither_x_defeated_0 basic_neither_isBanned_0))
(declare-fun basic_neither_x_support_score_0 () Real)
(assert (= basic_neither_x_support_score_0 (ite basic_neither_isAdmin_0 1.0 0.0)))
(declare-fun basic_neither_x_defeat_score_0 () Real)
(assert (= basic_neither_x_defeat_score_0 (ite basic_neither_isBanned_0 1.0 0.0)))
(declare-fun basic_neither_x_resolved_0 () Bool)
(assert (= basic_neither_x_resolved_0 (ite (and basic_neither_x_supported_0 (not basic_neither_x_defeated_0)) true (ite (and basic_neither_x_defeated_0 (not basic_neither_x_supported_0)) false (ite (and basic_neither_x_supported_0 basic_neither_x_defeated_0) (>= basic_neither_x_support_score_0 basic_neither_x_defeat_score_0) false)))))
(assert (or basic_neither_x_supported_0 basic_neither_x_defeated_0))
(assert (= basic_neither_isAdmin_0 false))
(assert (= basic_neither_isBanned_0 false))