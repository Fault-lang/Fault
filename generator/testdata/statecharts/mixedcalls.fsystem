system mixedcalls;

import simple "../simpleA.fspec";

global fl = new simple.fl;

component a = states{
    choice: sfunc{
        advance(this.option1) || (advance(this.option2) && advance(this.option3));
    },
    option1: sfunc{
        (advance(this.option1) && advance(this.option2)) || advance(this.option3);
    },
    option2: sfunc{
        if simple.active {
            advance(this.option1) || advance(this.option3);
        }
    },
    option3: sfunc{
        if !simple.active {
            advance(this.option1) || advance(this.option2);
        }else{
            advance(this.option1) && advance(this.option2) || advance(this.option3);
        }
    },
};

run {
    a.choice;
}