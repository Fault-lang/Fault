system ador;

component a = states{
    choice: sfunc{
        advance(this.option1) || advance(this.option2) || advance(this.option3);
    },
    option1: sfunc{
        advance(this.choice) || advance(this.option2) || advance(this.option3) || advance(this.option4);
    },
    option2: sfunc{
        stay();
    },
    option3: sfunc{
        advance(this.option2);
    },
    option4: sfunc{
        stay();
    }, 
};

run {
    a.choice;
}
