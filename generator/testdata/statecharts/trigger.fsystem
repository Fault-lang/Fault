system trigger;

import simple "../simpleA.fspec";

global fl = new simple.fl;

component x = states{
    foo: sfunc{
        fl.fn;
    },
    bar: sfunc{
        if simple.active {
            fl.fn;
        }
    },
    bash: sfunc{
        if simple.active {
            advance(this.foo);
        }else{
            fl.fn;
        }
    },
};

run {
    x.foo;
}